"""Numbers for the post-review fix list (2026-09-25).

Reads only existing result files; no AWS calls. Writes
scripts/fixes/fix_numbers.json and prints a markdown summary.
"""
import json, glob, os, random, statistics as st

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
EXP = os.path.join(ROOT, "experiments")
rng = random.Random(42)

def pct(xs, q):
    xs = sorted(xs); k = (len(xs) - 1) * q; f = int(k); c = min(f + 1, len(xs) - 1)
    return xs[f] + (xs[c] - xs[f]) * (k - f)

def boot_ci(xs, q, B=5000):
    n = len(xs); vals = []
    for _ in range(B):
        s = [xs[rng.randrange(n)] for _ in range(n)]
        vals.append(pct(s, q))
    return pct(vals, 0.025), pct(vals, 0.975)

def cell(path):
    lats = []
    for line in open(path):
        r = json.loads(line)
        if r.get("op") == "query" and r.get("ok"):
            lats.append(r["latency_s"])
    lo50, hi50 = boot_ci(lats, 0.5); lo95, hi95 = boot_ci(lats, 0.95)
    return dict(n=len(lats), p50=pct(lats, .5), p50_ci=[lo50, hi50],
                p95=pct(lats, .95), p95_ci=[lo95, hi95], mean=st.mean(lats), max=max(lats))

out = {"latency_ci": {}}
for exp in ["experiment_b", "experiment_c3"]:
    for f in sorted(glob.glob(os.path.join(EXP, exp, "results", "sweep_*.jsonl"))):
        out["latency_ci"][f"{exp}/{os.path.basename(f)}"] = cell(f)

# --- cost levels -------------------------------------------------------------
X86 = 0.0000166667; ARM = 0.0000133334; LREQ = 0.2e-6
S3GET = 0.4e-6; S3PUT = 5e-6
S3V_REQ = 2.5e-6
TIERS = [(100_000, 0.004), (10_000_000, 0.002), (float("inf"), 0.0004)]  # $/TB by vector count band
VEC_BYTES = 96 * 4  # vector data only; keys/metadata would add a little

def s3v_query_cost(n_vectors, vec_bytes=VEC_BYTES, tb=1e12):
    cost, prev = 0.0, 0
    for upper, rate in TIERS:
        band = max(0, min(n_vectors, upper) - prev)
        cost += band * vec_bytes / tb * rate
        prev = upper
        if n_vectors <= upper: break
    return dict(request=S3V_REQ, data_processed=cost, total=S3V_REQ + cost)

def blocks_s3_requests(num_blocks, n_map, n_reduce=1):
    tasks = n_map + n_reduce
    gets = num_blocks + 1 + 2 * tasks        # block files + config.json + lithops func/data per task
    puts = 1 + 2 + 2 * tasks                 # query file + job func/data + status/output per task
    return dict(gets=gets, puts=puts, cost=gets * S3GET + puts * S3PUT,
                note="estimate; excludes Lithops polling LIST/GET requests")

out["cost"] = {
    "s3v_1m": s3v_query_cost(1_000_000),
    "s3v_10m": s3v_query_cost(10_000_000),
    "blocks_1m_base_l1": 0.000186, "blocks_1m_bpt8_l1": 0.00012588,
    "blocks_10m_l1": 1.4754e-3, "lancedb_1m_l1": 0.000134, "lancedb_10m_l1": 1.3994e-3,
    "blocks_1m_base_s3req": blocks_s3_requests(16, 1),
    "blocks_1m_bpt8_s3req": blocks_s3_requests(16, 2),
    "blocks_10m_s3req": blocks_s3_requests(160, 20),
}
c = out["cost"]
c["ratios_l1_request_only"] = {
    "1m_lancedb": c["lancedb_1m_l1"] / S3V_REQ, "1m_blocks_base": c["blocks_1m_base_l1"] / S3V_REQ,
    "1m_blocks_bpt8": c["blocks_1m_bpt8_l1"] / S3V_REQ,
    "10m_lancedb": c["lancedb_10m_l1"] / S3V_REQ, "10m_blocks": c["blocks_10m_l1"] / S3V_REQ}
b1 = c["blocks_1m_base_l1"] + c["blocks_1m_base_s3req"]["cost"]
b8 = c["blocks_1m_bpt8_l1"] + c["blocks_1m_bpt8_s3req"]["cost"]
b10 = c["blocks_10m_l1"] + c["blocks_10m_s3req"]["cost"]
c["level2"] = {"s3v_1m": c["s3v_1m"]["total"], "s3v_10m": c["s3v_10m"]["total"],
